# Copy to .env and change the password. scripts/run.sh generates a .env
# with a random password automatically if it doesn't exist.
POSTGRES_DB=market
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Binance symbols to follow (@trade streams)
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt

# commit every BATCH_SIZE ticks or every FLUSH_INTERVAL_SEC seconds
BATCH_SIZE=500
FLUSH_INTERVAL_SEC=2
# in-memory buffer cap
MAX_BUFFER=50000
